# Valkey Admin server configuration.
# Changes take effect on: systemctl restart valkey-admin

DEPLOYMENT_MODE=Web
PORT=8080
DATA_DIR=/var/lib/valkey-admin

# Metrics collector config file. Left unset, it defaults to a path under
# /usr (next to the installed collector code). This service runs with
# ProtectSystem=strict (see valkey-admin.service), which makes /usr
# read-only, so at that default any collector config change made through
# the UI fails to persist across a restart -- the collector degrades
# gracefully and logs the failed write rather than crashing, but the edit
# is lost. Point this at a path under DATA_DIR, which the unit's
# ReadWritePaths keeps writable, to make collector config survive restarts.
#CONFIG_PATH=/var/lib/valkey-admin/metrics-config.yml

# Bind address. Left unset, the server binds 127.0.0.1.
#
# Web mode has NO authentication beyond a session cookie. Binding to a routable
# address exposes every Valkey instance this server can reach to anyone who can
# open the port. Set this only behind an authenticating proxy.
#SERVER_BIND_HOST=127.0.0.1

# Extra websocket origins to accept, comma-separated. Same-origin requests are
# always accepted, so this is only needed when the UI is served from elsewhere.
#VALKEY_ADMIN_ALLOWED_WS_ORIGINS=https://valkey-admin.example.com

# Pre-configured connection. When set, the server connects at startup and
# starts collectors without an operator adding the connection in the UI.
#VALKEY_HOST=valkey.example.com
#VALKEY_PORT=6379
#VALKEY_USERNAME=
#VALKEY_PASSWORD=
#VALKEY_TLS=false
