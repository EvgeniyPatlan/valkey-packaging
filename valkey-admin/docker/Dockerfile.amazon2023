FROM amazonlinux:2023
# No explicit "curl" here: the base image already carries curl-minimal,
# which provides /usr/bin/curl (confirmed against the base image) -- good
# enough for the Syft installer script below. Amazon Linux 2023's
# curl-minimal and the full curl package both Provide "curl" and conflict
# with each other; requesting "curl" explicitly here fails the install with
# a curl-minimal/curl conflict rather than a clean swap (the same
# curl-minimal-vs-curl clash tests/test-service-runtime.sh's comment notes
# for rockylinux:9, there solved with --allowerasing -- simplest here is to
# just not ask for a curl this image already has).
RUN dnf -y install rpm-build rpmdevtools createrepo_c \
      git tar gzip findutils which python3 systemd-rpm-macros \
      nodejs22 nodejs22-npm \
 && dnf clean all
# Syft: scans the built payload tree at package-build time to generate the
# embedded SBOM (rpm/percona-valkey-admin.spec %install, via the repo-root
# scripts/gen-module-sbom.sh). Pinned, not latest, so what a rebuild
# catalogs stays reproducible -- same version every image installs.
RUN curl -sSfL https://get.anchore.io/syft | sh -s -- -b /usr/local/bin v1.49.0
WORKDIR /build
