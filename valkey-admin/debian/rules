#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

# The source root here is the extracted upstream valkey-admin-1.1.1 release
# tarball (build-deb.sh assembles it that way; see README.packaging.md).
# packaging/ is not part of that tarball -- it never was, on any version --
# so the build helper and the aux files this package installs are not in
# $(CURDIR); build-deb.sh bind-mounts this product directory into the build
# container at /packaging, read-only, and the two rules below reach into it
# by absolute path. This is the same mechanism rpm/build-rpm.sh already used
# to supply Source1 to the spec before this port; here it also supplies the
# build helper and the two aux files this side needs (the systemd unit and
# the env file -- DEB has no equivalent of the RPM sysusers/tmpfiles
# fragments, since debian/percona-valkey-admin-server.postinst creates the
# user and directory directly).
override_dh_auto_build:
	bash /packaging/common/build-server-payload.sh "$(CURDIR)" "$(CURDIR)/_payload"
	cp /packaging/README.packaging.md README.packaging.md

override_dh_auto_install:
	mkdir -p debian/percona-valkey-admin-server/usr/lib/percona-valkey-admin-server
	cp -a _payload/. debian/percona-valkey-admin-server/usr/lib/percona-valkey-admin-server/
	install -Dm0644 /packaging/rpm/valkey-admin.service \
	  debian/percona-valkey-admin-server/lib/systemd/system/valkey-admin.service
	install -Dm0640 /packaging/rpm/valkey-admin.env \
	  debian/percona-valkey-admin-server/etc/valkey-admin/valkey-admin.env
	install -d -m0750 debian/percona-valkey-admin-server/var/lib/valkey-admin

# The payload ships a prebuilt native addon; dh_strip and dh_shlibdeps must not
# try to reason about it.
override_dh_strip:
override_dh_shlibdeps:

override_dh_auto_test:
