Description: Build against a system-provided valkeymodule.h instead of cloning valkey.
 valkey-json 1.0.2 unconditionally ExternalProject-clones valkey-io/valkey just to
 obtain valkeymodule.h. Replace that with a copy from a system path (default
 /usr/include/valkeymodule.h, shipped by percona-valkey-dev / percona-valkey-devel)
 so the module builds offline and against the installed server ABI.
Author: Percona Build <info@percona.com>
Forwarded: not-needed

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100,30 +100,22 @@
     endif()
 endif()
 
-ExternalProject_Add(
-    valkey
-    GIT_REPOSITORY https://github.com/valkey-io/valkey.git
-    GIT_TAG ${VALKEY_VERSION}
-    PREFIX ${VALKEY_DOWNLOAD_DIR}
-    CONFIGURE_COMMAND ""
-    BUILD_COMMAND ${VALKEY_BUILD_CMD}
-    INSTALL_COMMAND ""
-    BUILD_IN_SOURCE 1
-)
-
 # Define the paths for the copied files
 set(VALKEY_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src/include")
 set(VALKEY_BINARY_DEST "${CMAKE_CURRENT_SOURCE_DIR}/tst/integration/.build/binaries/${VALKEY_VERSION}")
 
-ExternalProject_Add_Step(
+# Percona packaging: build against a system-provided valkeymodule.h (shipped by
+# percona-valkey-dev / percona-valkey-devel) instead of cloning valkey-io/valkey.
+# This keeps the package build fully offline and aligned with the installed
+# server's module ABI. Override the location with -DVALKEY_MODULE_H_PATH=...
+if(NOT VALKEY_MODULE_H_PATH)
+    set(VALKEY_MODULE_H_PATH "/usr/include/valkeymodule.h")
+endif()
+add_custom_target(
     valkey
-    copy_header_files
-    COMMENT "Copying header files to include/ directory"
-    DEPENDEES download
-    DEPENDERS configure
     COMMAND ${CMAKE_COMMAND} -E make_directory ${VALKEY_INCLUDE_DIR}
-    COMMAND ${CMAKE_COMMAND} -E copy ${VALKEY_DOWNLOAD_DIR}/src/valkey/src/valkeymodule.h ${VALKEY_INCLUDE_DIR}/valkeymodule.h
-    ALWAYS 1
+    COMMAND ${CMAKE_COMMAND} -E copy ${VALKEY_MODULE_H_PATH} ${VALKEY_INCLUDE_DIR}/valkeymodule.h
+    COMMENT "Using system valkeymodule.h: ${VALKEY_MODULE_H_PATH}"
 )
 
 # Integration tests require the valkey-test-framework which is only needed when
